        {
            "name": "Web&Design",
            "homepage": "https://www.webetdesign.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "sonata-project/admin-bundle": "4.* || ^3.45",
        "sonata-project/block-bundle": "^5.0",
        "webetdesign/wd-media-bundle": "^6.4.0",
        "gedmo/doctrine-extensions": "^3.0",
        "a2lix/translation-form-bundle": "^3.0",
        "doctrine/doctrine-bundle": "^1.12 || ^2.0",
        "doctrine/orm": "^2.6.4 || ^3.0",
        "knplabs/doctrine-behaviors": "^2.0",
        "symfony/asset": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/expression-language": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/options-resolver": "^6.4",
        "symfony/property-access": "^6.4",
        "symfony/security-acl": "^3.1",
        "symfony/security-bundle": "^6.4",
        "symfony/security-core": "^6.4",
        "symfony/security-csrf": "^6.4",
        "symfony/templating": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bridge": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/mailer": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/messenger": "^6.4",
        "ext-openssl": "*"
    },
    "require-dev": {
        "symfony/filesystem": "^5.4|^6.0",
        "symfony/phpunit-bridge": "^5.4|^6.0",
        "symfony/yaml": "^5.4|^6.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "WebEtDesign\\NewsletterBundle\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/webetdesign/wd-media-bundle"
        }
